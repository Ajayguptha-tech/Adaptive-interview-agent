# ==============================================================================
# Adaptive Interview Intelligence - Environment Configuration Template
# ==============================================================================

# Fast API Backend Configuration
HOST=127.0.0.1
PORT=8000

# Local LLM / Ollama Configuration
# Ensure Ollama is installed and running: `ollama run qwen2.5:7b`
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Google Gemini API (Optional fallback for hosted resume optimization)
# Leave empty if using local Ollama and local heuristic analysis only
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database Persistence (SQLite)
DATABASE_PATH=resumeiq.db
