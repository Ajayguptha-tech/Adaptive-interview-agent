# ==============================================================================
# Adaptive Interview Intelligence - Environment Configuration Template
# ==============================================================================

# FastAPI Backend Configuration
HOST=127.0.0.1
PORT=8000

# AI Provider Selection: 'ollama' (for local offline dev) or 'gemini' (for cloud / Render)
# - Set LLM_PROVIDER=ollama for local offline execution with Ollama.
# - Set LLM_PROVIDER=gemini for hosted execution with Google Gemini.
LLM_PROVIDER=ollama

# ------------------------------------------------------------------------------
# Provider 1: Local Ollama Configuration (Recommended for Local Dev)
# ------------------------------------------------------------------------------
# 1. Install Ollama from https://ollama.com
# 2. Verify Ollama is running: curl http://127.0.0.1:11434/api/tags
# 3. Pull an installed model:
#      ollama pull llama3.2:1b   # Fast, lightweight (~1.3 GB)
#      ollama pull qwen2.5:7b    # Higher capacity (~4.7 GB)
# 4. Set OLLAMA_MODEL to your installed model name.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b

# ------------------------------------------------------------------------------
# Provider 2: Google Gemini API (Recommended for Render Cloud Deployment)
# ------------------------------------------------------------------------------
# Important: On Render, 127.0.0.1 refers to the cloud container, not your laptop.
# Render must use Gemini unless you have a publicly accessible, secured Ollama host.
# Get an API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Database Persistence (SQLite)
DATABASE_PATH=resumeiq.db
